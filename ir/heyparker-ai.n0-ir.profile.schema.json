{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://n0.dev/schema/heyparker-ai-design-repo-ir.schema.json",
  "title": "N0 heyparker-ai Design Repo Composition IR Profile",
  "description": "Repository-specific profile for the heyparker-ai-design-repo design repo, generated by website-builder. Every const is copied from design-repo/registry.manifest.json. The repo's status is 'design-review-pending' (productionApproved=false); this profile does not override that: do not treat a document that validates here as generation-approved until a human design lead has signed off (productionApprovalGate).",
  "allOf": [
    {
      "$ref": "n0-design-repo-composition-ir.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "designRepo": {
          "type": "object",
          "properties": {
            "repositoryId": {
              "const": "heyparker-ai-design-repo"
            },
            "repositoryVersion": {
              "const": "0.1.0"
            },
            "pageSpecVersion": {
              "const": "0.1.0"
            },
            "theme": {
              "const": "dark"
            },
            "themeMode": {
              "const": "dark"
            },
            "productionApprovalGate": {
              "const": false
            },
            "contracts": {
              "type": "object",
              "properties": {
                "manifest": {
                  "const": "registry.manifest.json"
                },
                "pageSpecSchema": {
                  "const": "schema/pagespec.schema.json"
                },
                "templates": {
                  "const": "templates/templates.json"
                },
                "tokenCatalog": {
                  "const": "tokens/llm/token-catalog.json"
                },
                "tokenPolicy": {
                  "const": "tokens/llm/token-policy.json"
                },
                "componentAllowlist": {
                  "const": "tokens/llm/component-allowlist.json"
                },
                "compatibilityGraph": {
                  "const": "compatibility/graph.json"
                },
                "assetContract": {
                  "const": "assets/asset-roles.json"
                },
                "motionSpec": {
                  "const": "motion/motion-contract.json"
                },
                "semanticValidator": {
                  "const": "schema/semantic_validate.py"
                }
              }
            }
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "templateId": {
                "enum": [
                  "template.home",
                  "template.support"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
