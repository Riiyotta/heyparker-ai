{
  "name": "heyparker-ai-clone",
  "private": true,
  "type": "module",
  "description": "React clone converted from the captured pages (lib/clone.mjs), plus the offline mirror (mirror/), IA, design repo and IR.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "python3 mirror/_serve.py",
    "ia:validate": "node validate.mjs",
    "ia:build": "node build.mjs",
    "verify": "python3 design-repo/extraction/verify_all.py",
    "ir:validate": "python3 ir/validate_ir.py",
    "drift": "python3 design-repo/extraction/prove_drift.py",
    "preview": "vite preview",
    "mirror": "python3 mirror/_serve.py",
    "qa:capture": "node qa/parity/capture.mjs",
    "qa:compare": "python3 qa/parity/compare.py",
    "qa:diffdom": "node qa/parity/diffdom.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "1.63.0",
    "vite": "^5.4.21"
  }
}
