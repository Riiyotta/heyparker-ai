{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PageSpec",
  "description": "A page composition. Styling is owned by section/component contracts; a PageSpec carries no style or token-override field.",
  "type": "object",
  "required": [
    "pageSpecVersion",
    "template",
    "route",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "pageSpecVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "template": {
      "type": "string",
      "enum": [
        "template.home",
        "template.support"
      ]
    },
    "route": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "assetRole": {
      "type": "string",
      "enum": [
        "logo",
        "customer-logo",
        "avatar",
        "icon",
        "illustration",
        "background",
        "hero-image",
        "content-image",
        "animation",
        "video",
        "font",
        "live-embed",
        "founder-contact-email"
      ]
    },
    "motion": {
      "type": "object",
      "required": [
        "pattern",
        "reducedMotionFallback"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string",
          "enum": [
            "none",
            "css-transition",
            "css-animation",
            "appear-on-enter",
            "scroll-linked",
            "canvas-animation"
          ]
        },
        "reducedMotionFallback": {
          "type": "string",
          "enum": [
            "disable-animation",
            "instant-state"
          ]
        }
      }
    },
    "content.commerce.pricing-section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 3
        },
        "subheading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 3
        },
        "body": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 15
          }
        },
        "ctas": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxWords": 8
              },
              "href": {
                "type": "string",
                "pattern": "^(/|#)",
                "description": "Relative path or #anchor only: generated pages must not link to the original site's live URLs."
              }
            }
          }
        },
        "items": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxWords": 1
              },
              "body": {
                "type": "string",
                "maxWords": 1
              }
            }
          }
        }
      },
      "required": [
        "heading",
        "subheading",
        "body",
        "ctas",
        "items"
      ]
    },
    "content.content.maze-section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 2
        },
        "subheading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 2
        },
        "body": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 7
          }
        },
        "images": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "assetRole"
            ],
            "additionalProperties": false,
            "properties": {
              "assetRole": {
                "$ref": "#/definitions/assetRole"
              },
              "alt": {
                "type": "string",
                "maxWords": 16
              }
            }
          }
        }
      },
      "required": [
        "heading",
        "subheading",
        "body"
      ]
    },
    "content.content.ribbon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxWords": 7
              }
            }
          }
        }
      },
      "required": [
        "items"
      ]
    },
    "content.cta.cta-button": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 3
          }
        },
        "ctas": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxWords": 6
              },
              "href": {
                "type": "string",
                "pattern": "^(/|#)",
                "description": "Relative path or #anchor only: generated pages must not link to the original site's live URLs."
              }
            }
          }
        }
      },
      "required": [
        "body",
        "ctas"
      ]
    },
    "content.cta.cta-section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 3
        },
        "subheading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 2
        },
        "body": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 9
          }
        },
        "images": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "assetRole"
            ],
            "additionalProperties": false,
            "properties": {
              "assetRole": {
                "$ref": "#/definitions/assetRole"
              },
              "alt": {
                "type": "string",
                "maxWords": 16
              }
            }
          }
        }
      },
      "required": [
        "heading",
        "subheading",
        "body"
      ]
    },
    "content.explainer.how-it-works-section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 2
        },
        "items": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxWords": 4
              },
              "body": {
                "type": "string",
                "maxWords": 7
              }
            }
          }
        },
        "images": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "assetRole"
            ],
            "additionalProperties": false,
            "properties": {
              "assetRole": {
                "$ref": "#/definitions/assetRole"
              },
              "alt": {
                "type": "string",
                "maxWords": 16
              }
            }
          }
        }
      },
      "required": [
        "heading",
        "items"
      ]
    },
    "content.explainer.notification-section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 11
        },
        "images": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "assetRole"
            ],
            "additionalProperties": false,
            "properties": {
              "assetRole": {
                "$ref": "#/definitions/assetRole"
              },
              "alt": {
                "type": "string",
                "maxWords": 16
              }
            }
          }
        }
      },
      "required": [
        "heading"
      ]
    },
    "content.hero.container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 3
        },
        "body": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 74
          }
        },
        "items": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxWords": 6
              }
            }
          }
        }
      },
      "required": [
        "heading",
        "body",
        "items"
      ]
    },
    "content.hero.hero-section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 10
        },
        "body": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 8
          }
        },
        "items": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxWords": 4
              }
            }
          }
        },
        "images": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "assetRole"
            ],
            "additionalProperties": false,
            "properties": {
              "assetRole": {
                "$ref": "#/definitions/assetRole"
              },
              "alt": {
                "type": "string",
                "maxWords": 16
              }
            }
          }
        }
      },
      "required": [
        "heading",
        "body",
        "items"
      ]
    },
    "content.proof.testimonials-section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 3
        },
        "subheading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 3
        },
        "body": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 30
          }
        },
        "images": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "assetRole"
            ],
            "additionalProperties": false,
            "properties": {
              "assetRole": {
                "$ref": "#/definitions/assetRole"
              },
              "alt": {
                "type": "string",
                "maxWords": 16
              }
            }
          }
        }
      },
      "required": [
        "heading",
        "subheading",
        "body"
      ]
    },
    "content.shell.navbar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 3
          }
        },
        "ctas": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxWords": 6
              },
              "href": {
                "type": "string",
                "pattern": "^(/|#)",
                "description": "Relative path or #anchor only: generated pages must not link to the original site's live URLs."
              }
            }
          }
        },
        "images": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "assetRole"
            ],
            "additionalProperties": false,
            "properties": {
              "assetRole": {
                "$ref": "#/definitions/assetRole"
              },
              "alt": {
                "type": "string",
                "maxWords": 16
              }
            }
          }
        }
      },
      "required": [
        "body",
        "ctas"
      ]
    },
    "content.support.framer-ktez73-container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxWords": 3
        },
        "body": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxWords": 6
          }
        },
        "ctas": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxWords": 2
              },
              "href": {
                "type": "string",
                "pattern": "^(/|#)",
                "description": "Relative path or #anchor only: generated pages must not link to the original site's live URLs."
              }
            }
          }
        },
        "images": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "assetRole"
            ],
            "additionalProperties": false,
            "properties": {
              "assetRole": {
                "$ref": "#/definitions/assetRole"
              },
              "alt": {
                "type": "string",
                "maxWords": 16
              }
            }
          }
        }
      },
      "required": [
        "heading",
        "body",
        "ctas"
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "type",
        "content",
        "motion"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "commerce.pricing-section",
            "content.maze-section",
            "content.ribbon",
            "cta.cta-button",
            "cta.cta-section",
            "explainer.how-it-works-section",
            "explainer.notification-section",
            "hero.container",
            "hero.hero-section",
            "proof.testimonials-section",
            "shell.navbar",
            "support.framer-ktez73-container"
          ]
        },
        "content": {
          "type": "object"
        },
        "motion": {
          "$ref": "#/definitions/motion"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "commerce.pricing-section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.commerce.pricing-section"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "content.maze-section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.content.maze-section"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "content.ribbon"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.content.ribbon"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cta.cta-button"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.cta.cta-button"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cta.cta-section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.cta.cta-section"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "explainer.how-it-works-section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.explainer.how-it-works-section"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "explainer.notification-section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.explainer.notification-section"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hero.container"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.hero.container"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hero.hero-section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.hero.hero-section"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "proof.testimonials-section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.proof.testimonials-section"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "shell.navbar"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.shell.navbar"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "support.framer-ktez73-container"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/definitions/content.support.framer-ktez73-container"
              }
            }
          }
        }
      ]
    }
  }
